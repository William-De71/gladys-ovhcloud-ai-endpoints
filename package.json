{
  "name": "gladys-ovhcloud-ai-endpoints",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration that runs the Gladys AI assistant on OVHcloud AI Endpoints (open models such as GPT-OSS, Qwen and Mistral, hosted in the European Union) with the API key of your Public Cloud project: chat, router, weekly digest, usage and estimated cost widget.",
  "homepage": "https://github.com/William-De71/gladys-ovhcloud-ai-endpoints",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-ovhcloud-ai-endpoints.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "ovhcloud",
    "ai-endpoints",
    "gpt-oss",
    "llm",
    "ai",
    "assistant",
    "home-automation"
  ]
}
